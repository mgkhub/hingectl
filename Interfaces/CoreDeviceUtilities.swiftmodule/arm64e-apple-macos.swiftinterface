}
public struct DeviceHingeAngleSnapshot {
  public var angle: Foundation.Measurement<Foundation.UnitAngle> { get }
  public var mechanicalAngle: Foundation.Measurement<Foundation.UnitAngle> { get }
  public var isAngleValid: Swift.Bool { get }
  public var minAngle: Foundation.Measurement<Foundation.UnitAngle> { get }
  public var maxAngle: Foundation.Measurement<Foundation.UnitAngle> { get }
  public var timestamp: Swift.Double { get }
}
public enum ScreenshotImageFormat : Swift.String, Swift.CaseIterable, Swift.Codable, Swift.Hashable {
  case png
  public init?(rawValue: Swift.String)
  public var rawValue: Swift.String { get }
}
public struct CaptureScreenshotOutput {
  public var image: CoreGraphics.CGImage { get }
  public var displayUniqueID: Swift.String? { get }
